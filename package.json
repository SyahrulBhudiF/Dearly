{
  "name": "dearly",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "build": "turbo run build",
    "check": "turbo run check",
    "test": "turbo run test",
    "lint": "oxlint .",
    "fmt": "oxfmt .",
    "fmt:check": "oxfmt --check .",
    "prepare": "husky",
    "dev": "turbo run dev",
    "deploy": "bun run build && cd apps/worker && bun run deploy",
    "destroy": "cd apps/worker && bun run destroy"
  },
  "dependencies": {
    "@effect/platform-browser": ">=4.0.0-beta.101",
    "effect": ">=4.0.0-beta.101",
    "foldkit": "^0.132.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20260724.1",
    "@effect/vitest": ">=4.0.0-beta.101",
    "@foldkit/oxlint-plugin": "^0.4.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.2.0",
    "oxfmt": "^0.60.0",
    "oxlint": "^1.75.0",
    "turbo": "^2.10.7",
    "typescript": "^7.0.2",
    "vite": "8.1.5",
    "vitest": "latest"
  },
  "lint-staged": {
    "*.ts": [
      "oxlint --fix",
      "oxfmt --write"
    ]
  },
  "packageManager": "bun@1.3.14"
}
